{
  "name": "@samyakbhuta/ui-components",
  "version": "0.1.0-beta.4",
  "description": "Web Components for AI chat apps, built on ui-sdk: a composer, messages with safe Markdown and coloured code, a streaming transcript, a thinking indicator, agent tool calls, cited sources, prompt suggestions, questions with choices, approval prompts, a whole chat in one tag, and a list of saved chats.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepublishOnly": "node scripts/check-tag.mjs"
  },
  "sideEffects": [
    "./dist/index.js",
    "./dist/ai-*.js",
    "./dist/shared/*.js",
    "./dist/css/*.css",
    "./src/**/*.ts"
  ],
  "customElements": "dist/custom-elements.json",
  "web-types": "./dist/web-types.json",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-composer": {
      "types": "./dist/ai-composer.d.ts",
      "default": "./dist/ai-composer.js"
    },
    "./ai-message": {
      "types": "./dist/ai-message.d.ts",
      "default": "./dist/ai-message.js"
    },
    "./ai-transcript": {
      "types": "./dist/ai-transcript.d.ts",
      "default": "./dist/ai-transcript.js"
    },
    "./ai-thinking": {
      "types": "./dist/ai-thinking.d.ts",
      "default": "./dist/ai-thinking.js"
    },
    "./ai-tool-call": {
      "types": "./dist/ai-tool-call.d.ts",
      "default": "./dist/ai-tool-call.js"
    },
    "./ai-sources": {
      "types": "./dist/ai-sources.d.ts",
      "default": "./dist/ai-sources.js"
    },
    "./ai-suggestions": {
      "types": "./dist/ai-suggestions.d.ts",
      "default": "./dist/ai-suggestions.js"
    },
    "./ai-question": {
      "types": "./dist/ai-question.d.ts",
      "default": "./dist/ai-question.js"
    },
    "./ai-approval": {
      "types": "./dist/ai-approval.d.ts",
      "default": "./dist/ai-approval.js"
    },
    "./ai-chat": {
      "types": "./dist/ai-chat.d.ts",
      "default": "./dist/ai-chat.js"
    },
    "./ai-chat-list": {
      "types": "./dist/ai-chat-list.d.ts",
      "default": "./dist/ai-chat-list.js"
    },
    "./react": {
      "types": "./dist/react.d.ts"
    },
    "./vue": {
      "types": "./dist/vue.d.ts"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts"
    },
    "./elements": {
      "types": "./dist/elements.d.ts"
    },
    "./markdown": {
      "types": "./dist/markdown.d.ts",
      "default": "./dist/markdown.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "default": "./dist/highlight.js"
    },
    "./*.css": "./dist/css/*.css",
    "./package.json": "./package.json",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./vscode.html-custom-data.json": "./dist/vscode.html-custom-data.json",
    "./web-types.json": "./dist/web-types.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@ui-sdk/core": "^0.1.0-beta.18",
    "@ui-sdk/web": "^0.1.0-beta.18"
  },
  "keywords": [
    "web-components",
    "custom-elements",
    "ai",
    "ask-user",
    "chat",
    "markdown",
    "ui-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samyakbhuta/ui-components.git",
    "directory": "packages/ui-components"
  },
  "homepage": "https://uisdk-components.netlify.app",
  "bugs": {
    "url": "https://github.com/samyakbhuta/ui-components/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
