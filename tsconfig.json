{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    /* The showcase imports the components by their package name; see vite.config.ts. */
    "paths": {
      "@samyakbhuta/ui-components": ["./packages/ui-components/src/index.ts"],
      "@samyakbhuta/ui-components/*": ["./packages/ui-components/src/*.ts"]
    }
  },
  "include": ["src", "packages/ui-components/src"]
}
